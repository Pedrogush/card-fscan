<?xml version="1.0" encoding="utf-8"?>
<!--
  The whole app is one Android-provided NativeActivity: Android starts it,
  it loads lib/<abi>/libfscan_android.so (named by the lib_name meta-data)
  and the Rust android-activity crate takes over from there.
  hasCode="false": there is no Java/Kotlin code (no classes.dex) in the APK.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.pedrogush.cardfscan.rs"
    android:versionCode="1"
    android:versionName="0.1.0">

    <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="36" />

    <application
        android:label="card-fscan (rs)"
        android:hasCode="false"
        android:extractNativeLibs="false"
        android:debuggable="true">

        <activity
            android:name="android.app.NativeActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|uiMode|density"
            android:theme="@android:style/Theme.Material.NoActionBar">
            <meta-data android:name="android.app.lib_name" android:value="fscan_android" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
